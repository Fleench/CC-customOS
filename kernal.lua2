-- ============================================================
local master_perms ={
    protected_files = {}
}
local native_fs = {}
for k, v in pairs(fs) do
    native_fs[k] = v
end
local ROOT = "root"

if not native_fs.exists(ROOT) then
    native_fs.makeDir(ROOT)
end

local FULL_EXEMPT     = { "tmp" }        -- read + write
local READONLY_EXEMPT = { "rom", "sys" } -- read only, never write/delete/makeDir

local function matches(path, prefix)
    return path == prefix or string.sub(path, 1, #prefix + 1) == prefix .. "/"
end

local function exemptKind(path)
    for _, p in ipairs(FULL_EXEMPT) do
        if matches(path, p) then return "full" end
    end
    for _, p in ipairs(READONLY_EXEMPT) do
        if matches(path, p) then return "readonly" end
    end
    return nil
end

-- needsWrite: true for delete/makeDir/open-in-write-mode
local function toReal(path, needsWrite, perms)
    perms = perms or false
    hperms = false
    if perms then
        if perms.protected_files == master_perms.protected_files then
            hperms = true
        end
    end
    path = native_fs.combine("", path or "")
    local kind = exemptKind(path)
    if kind == "full" then return path end
    if kind == "readonly" then
        if needsWrite then
            if not hperms then
            error("Perm Manager: \"" .. path .. "\" is read-only", 0)
            end
        end
        return path
    end
    if matches(path, ROOT) then return path end
    --error("Perm Manager: Permission Denied for path \"" .. path .. "\"", 0)
    return ""
end
local overrides = {
    open = function(path, mode, perms)
        local write = mode and (mode:find("w") or mode:find("a")) ~= nil
        return native_fs.open(toReal(path, write, perms), mode)
    end,
    exists    = function(path, perms) return native_fs.exists(toReal(path, false, perms)) end,
    isDir     = function(path, perms) return native_fs.isDir(toReal(path, false, perms)) end,
    list      = function(path , perms) return native_fs.list(toReal(path, false, perms)) end,
    getSize   = function(path, perms) return native_fs.getSize(toReal(path, false,perms)) end,
    isReadOnly = function(path, perms) return native_fs.isReadOnly(toReal(path, false, perms)) end,
    makeDir   = function(path, perms) return native_fs.makeDir(toReal(path, true, perms)) end,
    delete    = function(path, perms) return native_fs.delete(toReal(path, true, perms)) end,
    copy      = function(from, to, perms) return native_fs.copy(toReal(from, false, perms), toReal(to, true, perms)) end,
    move      = function(from, to, perms) return native_fs.move(toReal(from, true, perms), toReal(to, true, perms)) end,
    find      = function(pattern, perms) return native_fs.find(toReal(pattern, false, perms)) end,
    isExempt  = function(path, perms) return exemptKind(path) ~= nil end,
}

for name, func in pairs(overrides) do
    fs[name] = func
end

print("Kernel: sandbox ready, launching shell...")
shell.setDir("/root")
shell.run("clear")
shell_perms = {
    protected_files = master_perms.protected_files
}
local shell_env = setmetatable({
    PERMS = shell_perms
}, { __index = _G })
os.run(shell_env, "/sys/shell.lua")
print("Kernel: shell exited.")
--shell.run("shutdown")